# Vendor Hub Server Configuration
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster credentials:
# Example: mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/multi-vendor-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/multi-vendor-platform?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=vendor_hub_secure_jwt_secret_key_2026

# Environment
NODE_ENV=development
