{
  "name": "vendorhub-workspace",
  "private": true,
  "version": "2.0.0",
  "description": "VendorHub Multi-Vendor Marketplace Platform (Frontend + Backend)",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
